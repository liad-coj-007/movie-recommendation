erDiagram
    Movie ||--|{ HasGenre : "has"
    Genre ||--|{ HasGenre : "belongs_to"
    User ||--|{ Rating : "rates"
    Movie ||--|{ Rating : "is_rated"

    User ||--|{ UserGenreRating : "has"
    Genre ||--|{ UserGenreRating : "evaluates"

    User {
        int userId PK
        string userName "NOT NULL"
        string email  "NOT NULL, UNIQUE"
        string password "NOT NULL"
        int age "CHECK (age >= 0)"
    }

    Genre {
        int genreID PK
        string genreName "NOT NULL"
    }

    Movie {
        int movieID PK
        string movieName "NOT NULL" 
        datetime e "NOT NULL"
    }



    HasGenre {
        int movieID FK
        int genreID FK
    }

    Rating {
        int userID FK
        int movieID FK
        int rating "CHECK (rating >= 1 AND rating <= 5)"
        datetime timestamp "NOT NULL"
    }

    UserGenreRating {
        int genreID FK
        int userID FK
        decimal avgRating "CHECK (avgRating >= 0 AND avgRating <= 5)"
    }

